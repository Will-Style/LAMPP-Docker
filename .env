# Compose のプロジェクト名: [example]の箇所を変更
# コンテナ名やボリューム名の接頭辞になる（小文字英数字・ハイフン・アンダースコアのみ）
COMPOSE_PROJECT_NAME=example
# コンテナ間通信用のネットワーク名: [example]の箇所を変更
# 案件ごとに必ずユニークにする。ここが重複すると複数案件を同時に起動できない
APP_NETWORK=example-network

# SSL証明書の設定
CERT_NAME=_wildcard.local.localhost

# ホスト名: [example]の箇所を変更
VIRTUAL_HOST=example.local.localhost
# phpmyadminのホスト名: [example]の箇所を変更
MYADMIN_HOST_NAME=example-db.local.localhost

ROOT=./source

# PHP (Apache同梱のイメージを使用)
PHP_VERSION=8.5

# MySQL
# 9.7 は LTS。案件の要件に合わせて 8.4 や 8.0 に下げてもよい
MYSQL_VERSION=9.7
MYSQL_HOST=mysql
MYSQL_DATABASE=example
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=password
MYSQL_USER=dev
MYSQL_PASSWORD=password
# クライアントツールから直接繋ぐ時のホスト側ポート
# docker-compose.yml の ports を有効にする場合、他案件と重複しない番号にする
MYSQL_PORT=3316
TZ=Asia/Tokyo

# Apache の　log dir
APACHE_LOG_DIR=./log/web
